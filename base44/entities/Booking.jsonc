{
  "name": "Booking",
  "type": "object",
  "properties": {
    "cart_id": {
      "type": "string",
      "title": "Cart ID"
    },
    "cart_name": {
      "type": "string",
      "title": "Cart Name"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "customer_email": {
      "type": "string",
      "title": "Customer Email",
      "format": "email"
    },
    "customer_phone": {
      "type": "string",
      "title": "Customer Phone"
    },
    "start_datetime": {
      "type": "string",
      "title": "Start",
      "format": "date-time"
    },
    "end_datetime": {
      "type": "string",
      "title": "End",
      "format": "date-time"
    },
    "rate_type": {
      "type": "string",
      "title": "Rate Type",
      "enum": [
        "hourly",
        "daily"
      ],
      "default": "daily"
    },
    "total_price": {
      "type": "number",
      "title": "Total Price"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "confirmed",
        "cancelled"
      ],
      "default": "confirmed"
    }
  },
  "required": [
    "cart_id",
    "customer_name",
    "customer_email",
    "start_datetime",
    "end_datetime",
    "rate_type",
    "total_price"
  ]
}